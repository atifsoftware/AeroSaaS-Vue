APP_NAME=AeroSaaS-Vue
APP_ENV=development
APP_KEY=base64:AeroJS-Development-Secret-Key-32BytesLong!
APP_URL=http://localhost:3001
PORT=3001

# Database Configuration (Native SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

# Session & Security
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
COOKIE_SECRET=AeroJS-Cookie-Secret-MustBeStrongKey

# Mailer (Optional)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@aerosaas.dev
MAIL_FROM_NAME="AeroSaaS Vue"
